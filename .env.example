# Copy to .env and fill in. .env is gitignored; never commit real values.

# POST /ask (the AI analyst). Without both, /ask answers 503.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini

# Frontend origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

# Optional overrides (defaults shown).
# GCP_PROJECT=insightflow-analytics-489617
# MARTS_DATASET=dbt_marts
# MAX_BYTES_BILLED=200000000
# ASK_REQUESTS_PER_MINUTE=5
# ASK_REQUESTS_PER_DAY=200
# ASK_LOG_PATH=logs/ask.jsonl   ("-" logs to stdout, as in the Docker image)
